[Desktop Entry]
Type=Application
Name=Atlas
GenericName=File Manager
Comment=Modern cross-platform file manager
Exec=atlas %F
Icon=atlas
Terminal=false
Categories=System;FileManager;Utility;
# Registering inode/directory makes Atlas a candidate to open folders, and lets
# it be selected as the default file manager (see README).
MimeType=inode/directory;
Keywords=files;folders;explorer;manager;
StartupNotify=true
